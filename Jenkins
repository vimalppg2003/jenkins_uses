pipeline{
    agent { label 'server1' }
    stages{
         stage('Build'){
            steps{
                sh """
                    echo "runnig Build stage"
                    sudo cp index.html /var/www/html/index.nginx-debian.html
                    echo "complete Build stage"
                """
            }
        }
        stage('deploy'){
            steps{
                sh """
                    echo "runnig deploy stage"
                    sudo systemctl restart nginx
                    echo "complete deploy stage"
                """
            }
        }
    }
}
